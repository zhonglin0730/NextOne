{
  "name": "nextone",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "dev": "pnpm --filter @nextone/web dev",
    "mobile:dev": "pnpm --filter @nextone/mobile start",
    "mobile:android": "pnpm --filter @nextone/mobile android",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "server:run": "mvn -pl apps/server spring-boot:run",
    "server:test": "mvn -pl apps/server test",
    "db:up": "docker compose -f deploy/compose/compose.dev.yml up -d",
    "db:down": "docker compose -f deploy/compose/compose.dev.yml down",
    "prod:config": "docker compose --env-file deploy/compose/.env.production -f deploy/compose/compose.prod.yml config",
    "prod:up": "docker compose --env-file deploy/compose/.env.production -f deploy/compose/compose.prod.yml up -d --build",
    "prod:backup": "docker compose --env-file deploy/compose/.env.production -f deploy/compose/compose.prod.yml --profile maintenance run --rm backup"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
